{
  "name": "agente-core",
  "version": "0.1.0",
  "private": true,
  "description": "Cerebro central del ecosistema de agentes de Luis. API independiente que coordina misiones, revisa acciones de riesgo y notifica al humano via Telegram.",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.3",
    "postgres": "^3.4.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
